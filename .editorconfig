# The plugin describes its own style, so a checkout outside its home project still
# formats the same way. See CONTRIBUTING.md.
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = 150

[*.cs]
indent_style = space
indent_size = 4

[*.{json,uplugin}]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.ini]
indent_style = tab
insert_final_newline = true
